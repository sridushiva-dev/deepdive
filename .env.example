# Database — use Neon PostgreSQL (required for Vercel; SQLite not supported on serverless)
DATABASE_URL="postgresql://user:password@host.neon.tech/deepdive?sslmode=require"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encryption key for BYOK API keys (32 bytes hex = 64 chars)
ENCRYPTION_KEY=""

# Admin allowlist (comma-separated)
ADMIN_EMAILS="sridushiva@gmail.com"
